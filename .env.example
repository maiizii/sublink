# SubLink 管理平台示例环境变量
ADMIN_USER=admin
ADMIN_PASS=admin
BASE_DOMAIN=yet.la
SHORT_CODE_LEN=6

# TLS 证书自动签发配置
# 可选：如需接收 ACME 通知邮件，可填写有效邮箱；留空则表示跳过邮箱注册。
ACME_ACCOUNT_EMAIL=
CF_DNS_API_TOKEN=
ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
CERTBOT_CHECK_INTERVAL_SECONDS=43200
CF_DNS_PROPAGATION_SECONDS=60
CERTBOT_ADDITIONAL_DOMAINS=
